# ============================================================
# Campus Trace 环境变量配置模板
# 复制本文件为 .env 并填入真实值，切勿提交真实密钥到仓库
# ============================================================

# ---------- 服务 ----------
PORT=3000

# ---------- 向量库 Chroma ----------
# 需先启动 Chroma 服务：chroma run --path ./chroma_db
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=campus_trace_kb_v2

# ---------- 大模型（LLM）----------
# 默认走智谱 AI（GLM-4-Flash 永久免费）
# 注册获取 Key：https://open.bigmodel.cn
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_zhipu_api_key
LLM_MODEL=GLM-4-Flash

# ---------- 向量模型（Embedding）----------
# 智谱 Embedding-3，新用户赠送 2000 万 tokens
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=your_zhipu_api_key
EMBEDDING_MODEL=embedding-3

# ---------- RAG 调参 ----------
RAG_CHUNK_SIZE=500          # 单切片字符数
RAG_CHUNK_OVERLAP=80        # 相邻切片重叠字符数
RAG_TOP_K=5                 # 召回切片数
RAG_SCORE_THRESHOLD=1.5     # L2 距离阈值，超过视为无相关信息直接拒答
LLM_TIMEOUT_MS=30000        # LLM 请求超时（毫秒）
